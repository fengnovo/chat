{
  "name": "@repo/knowledge-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=development --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --conditions=development --import tsx src/main.ts",
    "start:prod": "NODE_ENV=production node --env-file-if-exists=../../.env --import ../../packages/observability/dist/register.js dist/main.js",
    "test": "node --conditions=development --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "1.9.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@repo/artifacts": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/knowledge-graphrag": "workspace:*",
    "@repo/observability": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
