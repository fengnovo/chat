[Unit]
Description=Chat Knowledge Service (GraphRAG index + MCP search)
Documentation=file:///opt/chat/deploy/README.md
After=network-online.target docker.service chat-api.service
Wants=network-online.target

[Service]
Type=simple
User=chatapp
Group=chatapp
WorkingDirectory=/opt/chat
EnvironmentFile=/opt/chat/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chat/apps/knowledge-service/dist/main.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
