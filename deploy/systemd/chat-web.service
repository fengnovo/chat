[Unit]
Description=Chat Agent Web (Next.js)
Documentation=file:///opt/chat/deploy/README.md
After=network-online.target chat-api.service
Wants=network-online.target

[Service]
Type=simple
User=chatapp
Group=chatapp
WorkingDirectory=/opt/chat/apps/web
EnvironmentFile=/opt/chat/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
# 监听端口来自 .env 的 PORT=3020
ExecStart=/usr/bin/node /opt/chat/apps/web/node_modules/next/dist/bin/next start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
