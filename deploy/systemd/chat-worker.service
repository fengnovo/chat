[Unit]
Description=Chat Agent Worker (BullMQ + Docker sandbox)
Documentation=file:///opt/chat/deploy/README.md
After=network-online.target docker.service chat-api.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=chatapp
Group=chatapp
# 需要访问 /var/run/docker.sock 来创建沙箱容器
SupplementaryGroups=docker
WorkingDirectory=/opt/chat
EnvironmentFile=/opt/chat/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chat/apps/worker/dist/worker.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
