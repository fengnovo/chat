{
  "name": "ai-cli",
  "version": "1.0.0",
  "description": "",
  "bin": {
    "ai-cli": "./dist/cli.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --conditions=development --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --import tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@repo/agent-core": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.10",
    "@langfuse/langchain": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "deepagents": "^1.13.2",
    "dotenv": "^17.4.2",
    "ink": "^5.2.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.9.0",
    "react": "^18.3.1",
    "zod": "^4.4.3"
