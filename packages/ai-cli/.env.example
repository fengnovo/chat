# 推荐复制为当前 demo20 目录下的 `.env`；也兼容仓库根目录的 `.env`。
# 两边都有时，demo20/.env 优先；终端中 export 的环境变量优先级最高。
# API Key 可在 https://smith.langchain.com/settings 创建。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_api_key
LANGSMITH_PROJECT=demo20-cli-todo-approval

# Optional for self-hosted LangSmith or API keys linked to multiple workspaces:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=your_workspace_id


LANGFUSE_SECRET_KEY="sk-lf-07935b9d-e0d1-4171-a09b-b35d3bb2c25e"
LANGFUSE_PUBLIC_KEY="pk-lf-6f2f7807-a481-4d77-a703-bd959bfc4db4"
LANGFUSE_BASE_URL="http://localhost:10086"
# 指向本地 Docker 服务


OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL=kimi-k2.7-code-highspeed
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
