{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file-if-exists=../../.env --conditions=development --import tsx src/migrate.ts",
    "test": "node --conditions=development --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
