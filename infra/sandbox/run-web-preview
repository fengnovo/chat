#!/bin/bash
# AI 代理自动化脚本：启动 Vite 开发服务器并监听文件变化
# 用于沙箱环境，支持右侧浏览器预览
#
# 用法：
#   run-web-preview [project_dir] [--watch]
#
# 示例：
#   run-web-preview                    # 使用默认工作区
#   run-web-preview my-website         # 指定子目录
#   run-web-preview --watch            # 自动检测子目录项目并切换

set -eu

WORKSPACE="/mnt/user-data/workspace"
PROJECT_DIR="${1:-.}"
VITE_PORT="${VITE_PORT:-5173}"
LOG_FILE="$WORKSPACE/.vite-dev.log"
PID_FILE="$WORKSPACE/.vite-dev.pid"
ACTIVE_PROJECT_FILE="$WORKSPACE/.active-project"
WATCH_MODE=false

# 解析参数
for arg in "$@"; do
  case "$arg" in
    --watch) WATCH_MODE=true ;;
  esac
done

# ── 颜色输出 ──────────────────────────────────────────────
info()  { echo -e "\033[36m[INFO]\033[0m  $*"; }
ok()    { echo -e "\033[32m[OK]\033[0m    $*"; }
warn()  { echo -e "\033[33m[WARN]\033[0m  $*"; }
err()   { echo -e "\033[31m[ERR]\033[0m   $*" >&2; }

# ── 启动 Vite ────────────────────────────────────────────
start_vite() {
  local dir="$1"
  info "启动 Vite (目录: $dir, 端口: $VITE_PORT)..."

  npx vite --host 0.0.0.0 --port "$VITE_PORT" > "$LOG_FILE" 2>&1 &
  VITE_PID=$!
  echo "$VITE_PID" > "$PID_FILE"
  echo "$dir" > "$ACTIVE_PROJECT_FILE"

  local max_wait=15 waited=0
  while [ $waited -lt $max_wait ]; do
    if grep -q "Local:" "$LOG_FILE" 2>/dev/null; then break; fi
    sleep 1
    waited=$((waited + 1))
  done

  if kill -0 "$VITE_PID" 2>/dev/null; then
    ok "Vite 已启动！预览: http://localhost:$VITE_PORT"
    return 0
  else
    err "Vite 启动失败！日志: $LOG_FILE"
    cat "$LOG_FILE" 2>/dev/null
    return 1
  fi
}

# ── 停止 Vite ────────────────────────────────────────────
stop_vite() {
  if [ -f "$PID_FILE" ]; then
    local old_pid
    old_pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
      info "停止 Vite (PID: $old_pid)..."
      kill "$old_pid" 2>/dev/null || true
      sleep 1
      kill -9 "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
}

# ── 检测子目录项目 ───────────────────────────────────────
detect_project_dir() {
  local latest_dir="" latest_time=0
  for dir in "$WORKSPACE"/*/; do
    [ -d "$dir" ] || continue
    local dn; dn=$(basename "$dir")
    case "$dn" in .*|node_modules) continue ;; esac
    if [ -f "$dir/package.json" ]; then
      local mt; mt=$(stat -c %Y "$dir/package.json" 2>/dev/null || echo 0)
      if [ "$mt" -gt "$latest_time" ]; then
        latest_time=$mt; latest_dir="$dn"
      fi
    fi
  done
  echo "$latest_dir"
}

# ── 确保项目目录有必要的文件 ─────────────────────────────
ensure_project_files() {
  local dir="$1"
  cd "$dir"

  # node_modules 符号链接
  if [ ! -d "node_modules" ] && [ ! -L "node_modules" ]; then
    if [ -d "/opt/chat-web-runtime/node_modules" ]; then
      ln -sf /opt/chat-web-runtime/node_modules "$dir/node_modules"
    fi
  fi

  # package.json
  if [ ! -f "package.json" ]; then
    cat > package.json <<'PKGJSON'
{
  "name": "sandbox-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base ./"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
PKGJSON
  fi

  # vite.config.ts
  if [ ! -f "vite.config.ts" ]; then
    cat > vite.config.ts <<'VITECFG'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
export default defineConfig({
  plugins: [react()],
  server: { host: '0.0.0.0', port: 5173 },
})
VITECFG
  fi

  # index.html
  if [ ! -f "index.html" ]; then
    cat > index.html <<'HTML'
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sandbox Preview</title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
HTML
  fi

  # src/main.tsx + App.tsx
  if [ ! -d "src" ]; then mkdir -p src; fi
  if [ ! -f "src/main.tsx" ]; then
    cat > src/main.tsx <<'TSX'
import React from 'react'
import ReactDOM from 'react-dom/client'
import App from './App'
ReactDOM.createRoot(document.getElementById('root')!).render(
  <React.StrictMode><App /></React.StrictMode>,
)
TSX
  fi
  if [ ! -f "src/App.tsx" ]; then
    cat > src/App.tsx <<'TSX'
export default function App() {
  return (
    <div style={{ padding: 20, fontFamily: 'system-ui' }}>
      <h1>🚀 Sandbox Preview</h1>
      <p>Vite 开发服务器已启动，修改代码后浏览器会自动刷新。</p>
    </div>
  )
}
TSX
  fi
}

# ══════════════════════════════════════════════════════════
# 主逻辑
# ══════════════════════════════════════════════════════════

# ── Watch 模式：自动检测子目录项目并切换 ──────────────────
if [ "$WATCH_MODE" = true ]; then
  info "═══ Watch 模式：自动检测子目录项目 ═══"

  # 初始启动
  if [ "$PROJECT_DIR" != "." ] && [ -d "$WORKSPACE/$PROJECT_DIR" ]; then
    ensure_project_files "$WORKSPACE/$PROJECT_DIR"
    cd "$WORKSPACE/$PROJECT_DIR"
  else
    ensure_project_files "$WORKSPACE"
    cd "$WORKSPACE"
  fi
  start_vite "$(pwd)"
  last_project="$(pwd)"

  info "开始监控子目录变化 (每5秒检测)..."

  while true; do
    sleep 5
    detected=$(detect_project_dir)
    if [ -n "$detected" ]; then
      new_project="$WORKSPACE/$detected"
      if [ "$new_project" != "$last_project" ]; then
        info "检测到新项目: $detected → 切换 Vite..."
        stop_vite
        rm -rf "$new_project/node_modules/.vite" 2>/dev/null || true
        ensure_project_files "$new_project"
        cd "$new_project"
        start_vite "$new_project"
        last_project="$new_project"
        ok "已切换到: $detected"
      fi
    fi
  done
fi

# ── 普通模式 ─────────────────────────────────────────────
FULL_PROJECT_DIR="$WORKSPACE/$PROJECT_DIR"
if [ "$PROJECT_DIR" != "." ] && [ -d "$FULL_PROJECT_DIR" ]; then
  ensure_project_files "$FULL_PROJECT_DIR"
  cd "$FULL_PROJECT_DIR"
else
  ensure_project_files "$WORKSPACE"
  cd "$WORKSPACE"
fi

info "项目目录: $(pwd)"
start_vite "$(pwd)"

echo ""
info "═══════════════════════════════════════════"
info "  本地访问:   http://localhost:$VITE_PORT"
info "  沙箱预览:   请查看沙箱平台生成的预览 URL"
info "  生产部署:   运行 npm run build 生成 dist/"
info "═══════════════════════════════════════════"
echo ""

if [ -f "$LOG_FILE" ]; then
  info "服务器日志:"
  cat "$LOG_FILE"
fi

info "服务器正在运行，按 Ctrl+C 停止..."
wait "$VITE_PID"
